{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.6-luna",
  "small_model": "opencode/nemotron-3.5-lightning-free",

  "subagent_depth": 0,

  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "context7_*": "deny"
      }
    },

    "explore": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "permission": {
        "context7_*": "deny"
      }
    },

    "general": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "permission": {
        "context7_*": "deny"
      }
    },

    "plan": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "permission": {
        "context7_*": "deny"
      }
    }
  },

  "tool_output": {
    "max_lines": 100,
    "max_bytes": 8000
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 5
  },

  "references": {
    "api-contract": {
      "repository": "LacruzJSDev/finanz-app-fast-api",
      "branch": "dev",
      "description": "Read-only API contract reference. Never modify this repository from the frontend workflow.",
      "hidden": true
    }
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "timeout": 30000
    }
  },

  "permission": {
    "context7_*": "deny",

    "bash": {
      "git status --short && git branch --show-current && git worktree list": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current*": "allow",
      "git worktree list*": "allow",
      "*": "ask"
    }
  }
}